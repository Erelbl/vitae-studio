# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI Providers
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
STORY_PROVIDER=claude
ILLUSTRATION_PROVIDER=gemini
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
FOLLOWUP_PROVIDER=claude

# Email
RESEND_API_KEY=
RESEND_FROM_EMAIL=                # e.g. "Vitae Studio <hello@studio-vitae.com>"
ENABLE_TEST_EMAIL=                # set to "true" to enable POST /api/admin/test-email
ADMIN_NOTIFICATION_EMAIL=         # internal email for admin notifications (approve/feedback)

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Film render worker — set to absolute path of your .remotion-bundle output directory
# Run `npm run bundle:remotion` once to create it, then set this to the full path.
# Example (Windows): REMOTION_BUNDLE_PATH=C:\path\to\vitae-studio\.remotion-bundle
# Example (Mac/Linux): REMOTION_BUNDLE_PATH=/home/user/vitae-studio/.remotion-bundle
REMOTION_BUNDLE_PATH=

# Kie.ai / Kling 2.6 — image-to-video generation for page-level motion
# Leave KIE_API_KEY blank to skip Kling generation (Remotion CSS-motion fallback is used).
KIE_API_KEY=
KIE_API_BASE_URL=https://api.kie.ai
KIE_VIDEO_MODEL=kling-2.6/image-to-video
