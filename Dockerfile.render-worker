FROM node:20-bookworm-slim

# ── Chrome headless shell runtime libraries ───────────────────────────────────
#
# Remotion auto-downloads its own Chrome headless shell at first render.
# That binary is dynamically linked and requires these system libraries.
# Without them the process fails immediately with:
#   libnspr4.so: cannot open shared object file: No such file or directory
#
# List covers the full set of shared objects needed by Chrome 120+ headless
# on Debian Bookworm (verified against the Puppeteer / Playwright known-good lists).
#
# ffmpeg + ffprobe are also required here for film assembly (audio muxing and
# clip-duration measurement via ffprobe).
RUN apt-get update && apt-get install -y --no-install-recommends \
    # Core crypto / NSPR / NSS — the originally missing libs
    libnspr4 \
    libnss3 \
    # X11 display stack
    libx11-6 \
    libx11-xcb1 \
    libxcb1 \
    libxcomposite1 \
    libxdamage1 \
    libxext6 \
    libxfixes3 \
    libxrandr2 \
    libxshmfence1 \
    libxkbcommon0 \
    libxtst6 \
    # Graphics / GPU abstraction (Chrome uses GBM even in headless mode)
    libdrm2 \
    libgbm1 \
    # Audio (needed even headless — Chrome links it unconditionally)
    libasound2 \
    # Accessibility / AT-SPI
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libatspi2.0-0 \
    # Text / font rendering
    libcairo2 \
    libfontconfig1 \
    libpango-1.0-0 \
    fonts-liberation \
    # GTK / D-Bus / GLib runtime
    libgtk-3-0 \
    libglib2.0-0 \
    libdbus-1-3 \
    libcups2 \
    # TLS / download
    ca-certificates \
    wget \
    # Film assembly: audio muxing + duration measurement
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# ── Node dependencies ─────────────────────────────────────────────────────────
# devDependencies must be included: tsx and the remotion CLI are used at runtime.
COPY package.json package-lock.json* ./
RUN npm ci

# ── Application source ────────────────────────────────────────────────────────
COPY . .

# ── Remotion bundle ───────────────────────────────────────────────────────────
# Build the Remotion composition bundle at image build time.
# The worker reads from .remotion-bundle/ when rendering scenes.
# Building here means the worker is ready to render immediately on start
# without needing a separate pre-step.
RUN npm run bundle:remotion

# ── Start ─────────────────────────────────────────────────────────────────────
CMD ["npm", "run", "render-worker"]
